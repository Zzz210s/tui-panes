{
  "name": "tui-panes",
  "version": "0.1.0",
  "description": "Embed multiple live terminal panes (PTY + terminal emulation + view composition) inside a Node TUI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "demo",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --test test/*.test.js",
    "demo": "node demo/demo.ts"
  },
  "keywords": [
    "tui",
    "terminal",
    "pty",
    "panes",
    "split",
    "xterm",
    "node-pty",
    "conpty"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zzz210s/tui-panes.git"
  },
  "author": "Zzz210s",
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
